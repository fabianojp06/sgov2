# SGO 2.0 — D12. A proteção principal vem do oom_score_adj (dev +500, produção -500; ver ajustar-oom.sh).
# Não incluir "node" em --prefer: o painel do Easypanel e o app de produção também são processos node.
EARLYOOM_ARGS="-m 5 -s 10 -r 3600 --prefer '(^|/)(vitest|tsx|esbuild|next-server|stress-ng)$' --avoid '(^|/)(postgres|dockerd|containerd|containerd-shim.*|traefik|sshd|systemd|earlyoom)$'"
