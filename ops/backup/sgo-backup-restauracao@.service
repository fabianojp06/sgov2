[Unit]
Description=SGO — teste de restauração (%i; US-015)
After=docker.service
Requires=docker.service

[Service]
# Um oneshot não tem limite de tempo por padrão: 1h impede um teste preso de ficar para sempre.
TimeoutStartSec=1h
Type=oneshot
EnvironmentFile=-/etc/sgo/alerta.env
ExecStart=/usr/local/sbin/sgo-backup-restauracao %i
Nice=10
IOSchedulingClass=idle
