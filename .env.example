# Copie para .env.local (fora do git). Nunca coloque credenciais de hml ou prod aqui (spec §11.5).
# O Docker Compose lê o .env (também fora do git): copie para lá as variáveis de compose abaixo.

# Compose de dev (D12): padrões da frente A.
# Frente B: COMPOSE_PROJECT_NAME=sgo-b, DB_PORT=56432, APP_PORT=3200, MAILPIT_PORT=8225.
COMPOSE_PROJECT_NAME=sgo-a
DB_PORT=55432
APP_PORT=3100
MAILPIT_PORT=8125
# Senha do superusuário do Postgres de dev (só dev local; escolha uma e não versione o .env).
POSTGRES_PASSWORD=

# Banco de dev local da frente A (porta 55432, só em 127.0.0.1).
DATABASE_URL="postgresql://sgo_app:sgo_app@127.0.0.1:55432/sgo_dev"
MIGRATE_DATABASE_URL="postgresql://sgo_migrator:sgo_migrator@127.0.0.1:55432/sgo_dev"
SHADOW_DATABASE_URL="postgresql://sgo_migrator:sgo_migrator@127.0.0.1:55432/sgo_shadow"
# Filas (pg-boss, US-010): papel sgo_fila, dono só do schema pgboss.
FILA_DATABASE_URL="postgresql://sgo_fila:sgo_fila@127.0.0.1:55432/sgo_dev"
NODE_OPTIONS="--max-old-space-size=1536"

# Acesso (P5). URL pública do sistema: origem dos links nos e-mails e do Secure do cookie de sessão.
# Em produção exige https; http só em 127.0.0.1/localhost.
URL_PUBLICA="http://127.0.0.1:3100"
# 1 só atrás do Traefik (hml e prod): o IP do cliente vem do último salto do X-Forwarded-For.
CONFIAR_PROXY=
# Administrador inicial: lido só pela seed (npm run db:seed). Em hml e prod, essas variáveis ficam
# só no serviço de migração do Easypanel e saem depois do primeiro acesso. Senha com 16+ caracteres.
ADMIN_INICIAL_LOGIN=
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_SENHA=

# As variáveis abaixo marcadas "só no worker" ou "só no app" valem assim em hml e prod (serviços
# separados no Easypanel). Em dev, o .env.local é lido pelos dois processos.
# Cargas de estrutura (P4): o worker aplica os lotes como sgo_sync. Só no worker, nunca no app.
SYNC_DATABASE_URL="postgresql://sgo_sync:sgo_sync@127.0.0.1:55432/sgo_dev"

# E-mail (US-025): SMTP só no worker. SMTP_SEGURANCA (tls | starttls | nenhuma) é obrigatória
# quando há SMTP_HOST, sem padrão; "nenhuma" só para o Mailpit local. Em hml e prod, as credenciais
# ficam só no serviço worker do Easypanel.
SMTP_HOST=
SMTP_PORTA=
SMTP_SEGURANCA=
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=

# Salários de cargo cifrados (D10, P4). Só no app; gere a chave com: openssl rand -base64 32
# ANTERIORES: id:chave separados por vírgula, para decifrar o que foi gravado com chaves antigas.
CHAVE_CIFRA_SALARIOS=
CHAVE_CIFRA_SALARIOS_ID=dev1
CHAVE_CIFRA_SALARIOS_ANTERIORES=

# Ambiente (dev | hml | producao). Obrigatório quando NODE_ENV=production (imagem).
AMBIENTE=dev
# Dados de referência (plano de contas, minuta de CC, cargos sintéticos) e carga de CC sem a
# aprovação da DIREX: só em dev e hml. As duas nunca em produção.
CARGA_DADOS_REFERENCIA=1
CC_CARGA_PROVISORIA=1
