{
  "name": "sgo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unidade",
    "test:int": "vitest run --project integracao",
    "test:arq": "vitest run --project arquitetura",
    "test:e2e": "TESTCONTAINERS_RYUK_DISABLED=true playwright test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "worker:dev": "tsx watch worker/index.ts",
    "worker:start": "node --import tsx worker/index.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-virtual": "3.14.14",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "next": "16.4.3",
    "nodemailer": "10.1.7",
    "pg-boss": "12.38.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.3.0",
    "fast-check": "4.10.2",
    "pg": "8.23.1",
    "picomatch": "4.0.7",
    "prisma": "7.10.1",
    "smtp-server": "3.19.21",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
