// Modelos do módulo orc (frente A, spec §12.3): orçamento anual da Administração Central (UC04.17,
// spec §6.6; plano do P6, Task 1). CC e conta são guardados pela classificação do C1, sem FK
// cruzada (§12.7 item 1). Situações, origens e prioridades são texto com CHECK na migration.

// Um exercício por ano, com o ciclo da §6.2. O trigger orc_ciclo_exercicio impõe as transições.
model OrcamentoExercicio {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ano               Int                  @unique
  situacao          String               @default("RASCUNHO")
  tetoManual        Decimal?             @map("teto_manual") @db.Decimal(15, 2)
  tetoJustificativa String?              @map("teto_justificativa")
  // Versão das premissas do C2 usada no último cálculo das linhas (R9).
  versaoPremissas   Int?                 @map("versao_premissas")
  enviadoPor        String?              @map("enviado_por") @db.Uuid
  versao            Int                  @default(0)
  criadoEm          DateTime             @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm      DateTime             @default(dbgenerated("clock_timestamp()")) @map("atualizado_em") @db.Timestamptz(6)
  oficializadoEm    DateTime?            @map("oficializado_em") @db.Timestamptz(6)
  posicoes          PosicaoOrcada[]
  pacotes           PacoteBaseZero[]
  linhas            LinhaOrcada[]
  receitas          ReceitaRateio[]
  importacoes       ImportacaoPlanilha[]
  tramites          TramiteExercicio[]
  snapshot          SnapshotExercicio?
  revisoes          RevisaoOrcamento[]

  @@map("orc_exercicio")
}

// Posição de pessoal (driver): cargo em texto livre na trilha (C34); salário sem cifra (D-P6-1).
// cargoId: cargo do cadastro de C&S (P15, D-P15-1), sem FK (§12.7: a tabela cargo é da frente B).
model PosicaoOrcada {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercicioId   String              @map("exercicio_id") @db.Uuid
  exercicio     OrcamentoExercicio  @relation(fields: [exercicioId], references: [id], onDelete: Restrict)
  cc            String
  cargo         String
  cargoId       String?             @map("cargo_id") @db.Uuid
  quantidade    Int
  salarioMensal Decimal             @map("salario_mensal") @db.Decimal(15, 2)
  mesInicio     Int                 @map("mes_inicio")
  mesSaida      Int                 @map("mes_saida")
  observacao    String?
  origem        String
  importacaoId  String?             @map("importacao_id") @db.Uuid
  importacao    ImportacaoPlanilha? @relation(fields: [importacaoId], references: [id], onDelete: Restrict)
  versao        Int                 @default(0)
  linhas        LinhaOrcada[]

  @@index([exercicioId, cc])
  @@map("orc_posicao")
}

model PacoteBaseZero {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercicioId   String              @map("exercicio_id") @db.Uuid
  exercicio     OrcamentoExercicio  @relation(fields: [exercicioId], references: [id], onDelete: Restrict)
  cc            String
  conta         String
  justificativa String
  prioridade    String
  quantidade    Int
  valorUnitario Decimal             @map("valor_unitario") @db.Decimal(15, 2)
  corrigirIpca  Boolean             @map("corrigir_ipca")
  distribuicao  String
  mesOcorrencia Int?                @map("mes_ocorrencia")
  origem        String
  importacaoId  String?             @map("importacao_id") @db.Uuid
  importacao    ImportacaoPlanilha? @relation(fields: [importacaoId], references: [id], onDelete: Restrict)
  versao        Int                 @default(0)
  linhas        LinhaOrcada[]

  @@index([exercicioId, cc])
  @@map("orc_pacote")
}

// Valor calculado (ORIGEM BLINDADA): uma linha por componente do C2 em cada posição, e uma por pacote.
model LinhaOrcada {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercicioId String             @map("exercicio_id") @db.Uuid
  exercicio   OrcamentoExercicio @relation(fields: [exercicioId], references: [id], onDelete: Restrict)
  cc          String
  conta       String
  origem      String
  componente  String?
  posicaoId   String?            @map("posicao_id") @db.Uuid
  posicao     PosicaoOrcada?     @relation(fields: [posicaoId], references: [id], onDelete: Cascade)
  pacoteId    String?            @map("pacote_id") @db.Uuid
  pacote      PacoteBaseZero?    @relation(fields: [pacoteId], references: [id], onDelete: Cascade)
  meses       Decimal[]          @db.Decimal(15, 2)
  total       Decimal            @db.Decimal(15, 2)

  @@index([exercicioId, cc])
  @@index([posicaoId])
  @@index([pacoteId])
  @@map("orc_linha")
}

// Rateio de um TP digitado na transição (C35): origem MANUAL_TRANSICAO, substituído na F3 (US-073).
model ReceitaRateio {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercicioId  String              @map("exercicio_id") @db.Uuid
  exercicio    OrcamentoExercicio  @relation(fields: [exercicioId], references: [id], onDelete: Restrict)
  tp           String
  descricao    String
  situacao     String
  origem       String              @default("MANUAL_TRANSICAO")
  meses        Decimal[]           @db.Decimal(15, 2)
  total        Decimal             @db.Decimal(15, 2)
  versao       Int                 @default(0)
  importacaoId String?             @map("importacao_id") @db.Uuid
  importacao   ImportacaoPlanilha? @relation(fields: [importacaoId], references: [id], onDelete: Restrict)

  @@unique([exercicioId, tp])
  @@map("orc_receita")
}

model ImportacaoPlanilha {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercicioId   String             @map("exercicio_id") @db.Uuid
  exercicio     OrcamentoExercicio @relation(fields: [exercicioId], references: [id], onDelete: Restrict)
  arquivoNome   String             @map("arquivo_nome")
  arquivoSha256 String             @map("arquivo_sha256") @db.Char(64)
  resumo        Json
  criadoPor     String             @map("criado_por") @db.Uuid
  criadoEm      DateTime           @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  posicoes      PosicaoOrcada[]
  pacotes       PacoteBaseZero[]
  receitas      ReceitaRateio[]

  @@map("orc_importacao")
}

// Histórico do ciclo de vida (avançar, enviar, aprovar, rejeitar com justificativa).
model TramiteExercicio {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercicioId   String             @map("exercicio_id") @db.Uuid
  exercicio     OrcamentoExercicio @relation(fields: [exercicioId], references: [id], onDelete: Restrict)
  de            String
  para          String
  usuarioId     String             @map("usuario_id") @db.Uuid
  justificativa String?
  em            DateTime           @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  @@index([exercicioId, em])
  @@map("orc_tramite")
}

// Snapshot imutável da oficialização (§6.2): JSON canônico e o sha256 dele.
model SnapshotExercicio {
  exercicioId String             @id @map("exercicio_id") @db.Uuid
  exercicio   OrcamentoExercicio @relation(fields: [exercicioId], references: [id], onDelete: Restrict)
  geradoEm    DateTime           @default(dbgenerated("clock_timestamp()")) @map("gerado_em") @db.Timestamptz(6)
  sha256      String             @db.Char(64)
  conteudo    Json

  @@map("orc_snapshot")
}

// Revisor de consistência antes do envio (US-064; plano do P14, Task 3): pedida na tela, processada no
// worker (fila orc.revisar). Sai de PENDENTE uma vez só, para CONCLUIDA ou FALHOU (trigger).
model RevisaoOrcamento {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercicioId     String             @map("exercicio_id") @db.Uuid
  exercicio       OrcamentoExercicio @relation(fields: [exercicioId], references: [id], onDelete: Restrict)
  // Versão do exercício no pedido: diferente da atual, a revisão está desatualizada.
  versaoExercicio Int                @map("versao_exercicio")
  situacao        String             @default("PENDENTE")
  achados         Json               @default("[]")
  avisos          String[]           @default([])
  solicitadoPor   String             @map("solicitado_por") @db.Uuid
  solicitante     Usuario            @relation(fields: [solicitadoPor], references: [id], onDelete: Restrict)
  criadoEm        DateTime           @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  concluidoEm     DateTime?          @map("concluido_em") @db.Timestamptz(6)

  @@index([exercicioId, criadoEm(sort: Desc)])
  @@map("orc_revisao")
}

// Proposta de TP (US-065; plano do P17, D-P17-1 a D-P17-10): a capa. O TP é a unidade (§6.7): o número
// do TP é o unidade.codigo e o CC próprio é o unidade.cc (C37). O Valor Global não tem coluna: é sempre
// calculado (§6.2, RN_TP_003). Exclusão lógica (RN_MAN_006, RN_TP_006): excluida_em e excluida_por, com
// a unidade inativada. Tipo e categoria são texto com CHECK na migration. RLS por unidade_id.
model PropostaTp {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidadeId   String           @unique @map("unidade_id") @db.Uuid
  unidade     Unidade          @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  tipo        String
  objeto      String
  parceiro    String?
  inicio      DateTime         @db.Date
  fim         DateTime         @db.Date
  categoria   String
  criadoPor   String           @map("criado_por") @db.Uuid
  criadoEm    DateTime         @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  excluidaEm  DateTime?        @map("excluida_em") @db.Timestamptz(6)
  excluidaPor String?          @map("excluida_por") @db.Uuid
  versao      Int              @default(0)
  versoes     VersaoProposta[]

  @@map("orc_proposta")
}

// Versão da proposta (§6.2): nasce a nº 1 em Rascunho, com a data e a hora do servidor (RN_PROP_002).
// O ciclo de vida (avançar, enviar, aprovar) fica para as histórias seguintes. RLS por unidade_id.
model VersaoProposta {
  id         String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidadeId  String                  @map("unidade_id") @db.Uuid
  unidade    Unidade                 @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  propostaId String                  @map("proposta_id") @db.Uuid
  proposta   PropostaTp              @relation(fields: [propostaId], references: [id], onDelete: Restrict)
  numero     Int
  situacao   String                  @default("RASCUNHO")
  criadoPor  String                  @map("criado_por") @db.Uuid
  criadoEm   DateTime                @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  metas      MetaProposta[]
  empregados EmpregadoProposta[]
  qtdes      QtdeEmpregadoProposta[]

  @@unique([propostaId, numero])
  @@index([unidadeId])
  @@map("orc_versao_proposta")
}

// Meta da proposta (US-067; plano do P19, D-P19-1 a D-P19-6): é da versão, e a nova versão e a duplicação
// a copiam (RN_DUP_003). Número único na versão sem diferença de maiúsculas (índice de expressão
// orc_meta_versao_numero_key, só na migration). Status e limites com CHECK na migration. RLS por unidade_id.
model MetaProposta {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidadeId        String                  @map("unidade_id") @db.Uuid
  unidade          Unidade                 @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  versaoPropostaId String                  @map("versao_proposta_id") @db.Uuid
  versaoProposta   VersaoProposta          @relation(fields: [versaoPropostaId], references: [id], onDelete: Restrict)
  numero           String
  nome             String
  valor            Decimal                 @db.Decimal(15, 2)
  status           String                  @default("ATIVO")
  observacao       String?
  criadoPor        String                  @map("criado_por") @db.Uuid
  criadoEm         DateTime                @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  versao           Int                     @default(0)
  empregados       EmpregadoProposta[]
  qtdes            QtdeEmpregadoProposta[]

  @@index([unidadeId])
  @@index([versaoPropostaId])
  @@map("orc_meta")
}

// Empregado (headcount) da proposta (US-070; plano do P20, D-P20-2): é da versão, com a meta obrigatória na
// categoria Meta (no caso de uso) e FK RESTRICT. Nome nulo é a vaga "A CONTRATAR" (RN0249). O cargo é do
// cadastro de C&S, sem FK (como a posição, P15), e o salário é a Fonte Ativa herdada ao salvar. A ordem é
// única por versão e meta. CHECKs na migration. RLS por unidade_id.
model EmpregadoProposta {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidadeId        String         @map("unidade_id") @db.Uuid
  unidade          Unidade        @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  versaoPropostaId String         @map("versao_proposta_id") @db.Uuid
  versaoProposta   VersaoProposta @relation(fields: [versaoPropostaId], references: [id], onDelete: Restrict)
  metaId           String?        @map("meta_id") @db.Uuid
  meta             MetaProposta?  @relation(fields: [metaId], references: [id], onDelete: Restrict)
  ordem            Int
  categoria        String
  nome             String?
  cargoId          String         @map("cargo_id") @db.Uuid
  salarioMensal    Decimal        @map("salario_mensal") @db.Decimal(15, 2)
  inicio           DateTime       @db.Date
  fim              DateTime       @db.Date
  dependentes      Int            @default(0)
  criadoPor        String         @map("criado_por") @db.Uuid
  criadoEm         DateTime       @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  versao           Int            @default(0)

  // NULLS NOT DISTINCT só na migration (o Prisma não o declara): a meta nula da Consolidada é um grupo só.
  @@unique([versaoPropostaId, metaId, ordem], map: "orc_empregado_versao_meta_ordem_key")
  @@index([unidadeId])
  @@index([versaoPropostaId])
  @@index([metaId])
  @@map("orc_empregado")
}

// Quantitativo de pessoal por período (US-070; plano do P20, D-P20-6): só o período e o documento são
// digitados; as quantidades são contadas dos empregados (RN0457). RLS por unidade_id.
model QtdeEmpregadoProposta {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unidadeId        String         @map("unidade_id") @db.Uuid
  unidade          Unidade        @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  versaoPropostaId String         @map("versao_proposta_id") @db.Uuid
  versaoProposta   VersaoProposta @relation(fields: [versaoPropostaId], references: [id], onDelete: Restrict)
  metaId           String?        @map("meta_id") @db.Uuid
  meta             MetaProposta?  @relation(fields: [metaId], references: [id], onDelete: Restrict)
  inicio           DateTime       @db.Date
  fim              DateTime       @db.Date
  documento        String
  criadoPor        String         @map("criado_por") @db.Uuid
  criadoEm         DateTime       @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  versao           Int            @default(0)

  @@index([unidadeId])
  @@index([versaoPropostaId])
  @@index([metaId])
  @@map("orc_qtde_empregado")
}
