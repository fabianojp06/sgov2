// Modelos do núcleo (src/shared/), da frente A (spec §12.3).

// Tipos de operação do Histórico (RN0103).
enum TipoOperacao {
  INSERCAO
  ALTERACAO
  EXCLUSAO
  CONSULTA
  IMPRESSAO
  EXPORTACAO
  LOGIN
  LOGOFF
  SISTEMA
}

enum OrigemOperacao {
  USUARIO
  SISTEMA
  SUGESTAO_IA
}

// Histórico de Operações (US-006): somente inserção, garantido por trigger e por privilégio.
model HistoricoOperacao {
  id             BigInt         @id @default(autoincrement())
  ocorridoEm     DateTime       @default(dbgenerated("clock_timestamp()")) @map("ocorrido_em") @db.Timestamptz(6)
  unidadeId      String?        @map("unidade_id") @db.Uuid
  usuarioId      String?        @map("usuario_id") @db.Uuid
  usuarioRotulo  String         @map("usuario_rotulo")
  sessaoUid      String?        @map("sessao_uid")
  ip             String?        @db.Inet
  funcionalidade String
  tipoOperacao   TipoOperacao   @map("tipo_operacao")
  registroId     String?        @map("registro_id")
  descricao      String
  antes          Json?
  depois         Json?
  delta          Json?
  origem         OrigemOperacao @default(USUARIO)

  @@index([funcionalidade, ocorridoEm])
  @@index([usuarioId, ocorridoEm])
  @@index([ocorridoEm])
  @@index([tipoOperacao, ocorridoEm])
  @@map("historico_operacao")
}

// Outbox transacional (US-010): a mensagem é gravada na transação da operação e publicada
// na fila depois do commit, pelo worker. Transação desfeita não publica nada. Depois de
// publicada, os dados são apagados da linha (C4: dado sensível não fica guardado).
model OutboxMensagem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo        String
  dados       Json
  criadoEm    DateTime  @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  publicadoEm DateTime? @map("publicado_em") @db.Timestamptz(6)
  // Falhas de publicação: a mensagem não trava as outras; com 10 tentativas, para e fica visível.
  tentativas  Int       @default(0)
  ultimoErro  String?   @map("ultimo_erro")

  @@map("outbox_mensagem")
}

// Unidade = Termo de Parceria (spec §5, C31). A proposta de TP (US-065, P17) cria a unidade: código =
// número do TP, nome = objeto (D-P17-2). A tabela serve também ao seletor de TP (US-031) e ao acesso
// por TP do usuário (US-038).
model Unidade {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo             String                  @unique
  nome               String
  ativo              Boolean                 @default(true)
  // CC próprio do TP (C37; plano do P17, D-P17-7): classificação do C1, sem FK (§12.7). Único entre
  // as unidades ativas (índice único parcial na migration 202611122100_orc_proposta, que o Prisma não
  // declara). Gravado só na criação da proposta; nulo nas unidades que não são TP.
  cc                 String?
  usuarios           UsuarioUnidade[]
  proposta           PropostaTp?
  versoesProposta    VersaoProposta[]
  metasProposta      MetaProposta[]
  empregadosProposta EmpregadoProposta[]
  qtdesEmpregado     QtdeEmpregadoProposta[]
  tetosViagem        TetoViagemProposta[]
  viagensProposta    ViagemProposta[]
  solicitacoes       SolicitacaoAprovacao[]
  snapshotsVersao    SnapshotVersao[]
  lotesPessoal       LotePessoal[]
  bensProposta       BemProposta[]
  rateiosProposta    RateioProposta[]
  celulasRateio      RateioCelulaProposta[]

  @@map("unidade")
}
