// Modelos do módulo adm (frente A, spec §12.3): identidade, perfis, catálogo e configuração de
// acesso (EP085 V3; plano do P5, Task 1).

enum NivelLog {
  SIMPLES
  AVANCADO
}

// Módulo de menu (spec §6.7). Instalado pela seed; o Administrador só ativa e desativa (REQ0055).
model Modulo {
  codigo          String           @id
  nome            String
  ordem           Int
  ativo           Boolean          @default(true)
  funcionalidades Funcionalidade[]

  @@map("modulo")
}

// Funcionalidade do catálogo (contrato C6): declarada pela seed de cada módulo.
model Funcionalidade {
  codigo       String            @id
  moduloCodigo String            @map("modulo_codigo")
  modulo       Modulo            @relation(fields: [moduloCodigo], references: [codigo], onDelete: Restrict)
  grupo        String
  nome         String
  rota         String
  ordem        Int
  ajuda        String?
  acoes        String[]
  nivelLog     NivelLog          @default(SIMPLES) @map("nivel_log")
  ativo        Boolean           @default(true)
  exibirNoMenu Boolean           @default(true) @map("exibir_no_menu")
  permissoes   PerfilPermissao[]
  excecoes     UsuarioExcecao[]

  @@map("funcionalidade")
}

// Perfil de acesso: os padrões vêm da seed (código fixo, §11.3); os criados pela tela (US-037) têm o
// código P_ + 12 hexadecimais (D-P13-2). Nome único sem diferenciar maiúsculas (índice perfil_nome_ci_key
// em lower(nome)), CHECKs de nome, descrição e código, e o gatilho que só deixa apagar perfil P_ ficam
// na migration 202611102000_adm_perfil_tela, que o Prisma não declara.
model Perfil {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo     String            @unique
  nome       String
  descricao  String
  ativo      Boolean           @default(true)
  versao     Int               @default(0)
  permissoes PerfilPermissao[]
  usuarios   UsuarioPerfil[]

  @@map("perfil")
}

model PerfilPermissao {
  perfilId             String         @map("perfil_id") @db.Uuid
  perfil               Perfil         @relation(fields: [perfilId], references: [id], onDelete: Restrict)
  funcionalidadeCodigo String         @map("funcionalidade_codigo")
  funcionalidade       Funcionalidade @relation(fields: [funcionalidadeCodigo], references: [codigo], onDelete: Restrict)
  acao                 String

  @@id([perfilId, funcionalidadeCodigo, acao])
  @@map("perfil_permissao")
}

// Usuário (UC02.11–UC02.14). Status e bloqueio são independentes (RN0063, RN0524).
model Usuario {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                   String
  email                  String
  login                  String
  loginNormalizado       String                  @unique @map("login_normalizado")
  ativo                  Boolean                 @default(true)
  bloqueado              Boolean                 @default(false)
  tentativasFalhas       Int                     @default(0) @map("tentativas_falhas")
  senhaHash              String                  @map("senha_hash")
  trocaSenhaObrigatoria  Boolean                 @default(true) @map("troca_senha_obrigatoria")
  senhaExpiraEm          DateTime?               @map("senha_expira_em") @db.Timestamptz(6)
  // Recuperação pela tela de login (US-029, D-P8-2): convive com a senha vigente até ser usada.
  recuperacaoHash        String?                 @map("recuperacao_hash")
  recuperacaoExpiraEm    DateTime?               @map("recuperacao_expira_em") @db.Timestamptz(6)
  // CC raiz de escopo do Gestor de Diretoria (C25, R8): classificação do CC, validada no P6.
  ccEscopo               String?                 @map("cc_escopo")
  // Incrementado quando o acesso muda (perfis, inativação, reset, desbloqueio): derruba as sessões.
  acessoVersao           Int                     @default(0) @map("acesso_versao")
  versao                 Int                     @default(0)
  criadoEm               DateTime                @default(dbgenerated("clock_timestamp()")) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm           DateTime                @default(dbgenerated("clock_timestamp()")) @map("atualizado_em") @db.Timestamptz(6)
  perfis                 UsuarioPerfil[]
  sessoes                SessaoUsuario[]
  alcadasTitular         AlcadaAprovacao[]       @relation("AlcadaTitular")
  alcadasSubstituto      AlcadaAprovacao[]       @relation("AlcadaSubstituto")
  sessoesEncerradas      SessaoEncerrada[]
  unidades               UsuarioUnidade[]
  desativacoesSistema    ConfiguracaoAcesso[]    @relation("ManutencaoPor")
  notificacoesDesempenho NotificacaoDesempenho[]
  revisoesOrcamento      RevisaoOrcamento[]

  @@map("usuario")
}

model UsuarioPerfil {
  usuarioId String           @map("usuario_id") @db.Uuid
  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  perfilId  String           @map("perfil_id") @db.Uuid
  perfil    Perfil           @relation(fields: [perfilId], references: [id], onDelete: Restrict)
  excecoes  UsuarioExcecao[]

  @@id([usuarioId, perfilId])
  @@map("usuario_perfil")
}

// Exceção de permissão por usuário (US-039, REQ0080, D-P10-2): retira do usuário uma funcionalidade
// que vem de um perfil associado a ele (só retirada, D-P10-1). Retirar o perfil apaga as exceções dele.
model UsuarioExcecao {
  usuarioId            String         @map("usuario_id") @db.Uuid
  perfilId             String         @map("perfil_id") @db.Uuid
  usuarioPerfil        UsuarioPerfil  @relation(fields: [usuarioId, perfilId], references: [usuarioId, perfilId], onDelete: Cascade)
  funcionalidadeCodigo String         @map("funcionalidade_codigo")
  funcionalidade       Funcionalidade @relation(fields: [funcionalidadeCodigo], references: [codigo], onDelete: Restrict)

  @@id([usuarioId, perfilId, funcionalidadeCodigo])
  @@index([funcionalidadeCodigo])
  @@map("adm_usuario_excecao")
}

// Parâmetros de acesso (linha única, id = 1). Valores [PROVISÓRIOS] da GAP-AUT-002 (spec §11.2a).
model ConfiguracaoAcesso {
  id                   Int       @id @default(1)
  limiteTentativas     Int       @default(5) @map("limite_tentativas")
  limiarAlerta         Int       @default(3) @map("limiar_alerta")
  inatividadeMin       Int       @default(30) @map("inatividade_min")
  sessaoMaximaHoras    Int       @default(12) @map("sessao_maxima_horas")
  senhaTemporariaHoras Int       @default(24) @map("senha_temporaria_horas")
  senhaMinimo          Int       @default(10) @map("senha_minimo")
  senhaExigeLetra      Boolean   @default(true) @map("senha_exige_letra")
  senhaExigeDigito     Boolean   @default(true) @map("senha_exige_digito")
  // Sistema inativo e manutenção são o mesmo indicador (US-036, D-P9-1). Desativar pela tela grava o
  // instante em que a desativação vale (agora + espera, D-P9-2), o motivo e quem desativou; nulo no
  // instante com o indicador ligado é a manutenção ligada direto no banco, que vale na hora. O CHECK
  // da migration exige os três nulos com o indicador desligado.
  manutencao           Boolean   @default(false)
  manutencaoAPartir    DateTime? @map("manutencao_a_partir") @db.Timestamptz(6)
  manutencaoMotivo     String?   @map("manutencao_motivo")
  manutencaoPorId      String?   @map("manutencao_por") @db.Uuid
  manutencaoPor        Usuario?  @relation("ManutencaoPor", fields: [manutencaoPorId], references: [id], onDelete: Restrict)
  // Espera entre o aviso e a desconexão (REQ0089, D-P9-3): 0 a 60 minutos [PROVISÓRIO].
  desconexaoEsperaMin  Int       @default(5) @map("desconexao_espera_min")

  @@map("configuracao_acesso")
}

// Permissões padrão já concedidas pela seed (R12): cada uma é aplicada uma vez só. Uma remoção feita
// pelo Administrador não volta, e um perfil ou uma ação nova recebe o padrão na próxima seed.
model PermissaoPadraoAplicada {
  perfilCodigo         String   @map("perfil_codigo")
  funcionalidadeCodigo String   @map("funcionalidade_codigo")
  acao                 String
  aplicadaEm           DateTime @default(dbgenerated("clock_timestamp()")) @map("aplicada_em") @db.Timestamptz(6)

  @@id([perfilCodigo, funcionalidadeCodigo, acao])
  @@map("permissao_padrao_aplicada")
}

// TPs que o usuário pode acessar (spec §5, UsuarioUnidade).
model UsuarioUnidade {
  usuarioId String  @map("usuario_id") @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  unidadeId String  @map("unidade_id") @db.Uuid
  unidade   Unidade @relation(fields: [unidadeId], references: [id], onDelete: Restrict)

  @@id([usuarioId, unidadeId])
  @@map("usuario_unidade")
}

// Alçada de aprovação (US-042, spec §6.5 e §11.4): por fluxo (WA01, WA02, WA05; CHECK no banco), com
// titular e substituto. Soft delete: trocar um aprovador ou excluir inativa a linha. Uma só ativa
// por fluxo (índice único parcial na migration, que o Prisma não declara).
model AlcadaAprovacao {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fluxo        String
  titularId    String    @map("titular_id") @db.Uuid
  titular      Usuario   @relation("AlcadaTitular", fields: [titularId], references: [id], onDelete: Restrict)
  substitutoId String    @map("substituto_id") @db.Uuid
  substituto   Usuario   @relation("AlcadaSubstituto", fields: [substitutoId], references: [id], onDelete: Restrict)
  ativa        Boolean   @default(true)
  inativadaEm  DateTime? @map("inativada_em") @db.Timestamptz(6)
  criadaEm     DateTime  @map("criada_em") @db.Timestamptz(6)
  versao       Int       @default(1)

  @@index([titularId])
  @@index([substitutoId])
  @@map("adm_alcada_aprovacao")
}

// Notificação de desempenho das contas (US-041, EP085 UC02.20, grupo "Desempenho"; D-P10-8): o
// destinatário de cada conta sintética, com o limite em % do orçado [PROVISÓRIO] e a frequência em
// dias (RN0067). A conta é a classificação do C1, sem FK para o cad; nulo é "Todas" (RN0051). Soft
// delete: excluir inativa a linha. Um destinatário por conta entre as ativas (índice único parcial
// NULLS NOT DISTINCT na migration, que o Prisma não declara). O envio (US-085) lerá as ativas e o
// ultimoEnvioEm.
model NotificacaoDesempenho {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contaClassificacao String?   @map("conta_classificacao")
  limitePercentual   Decimal   @map("limite_percentual") @db.Decimal(5, 2)
  frequenciaDias     Int       @map("frequencia_dias")
  usuarioId          String    @map("usuario_id") @db.Uuid
  usuario            Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  ultimoEnvioEm      DateTime? @map("ultimo_envio_em") @db.Timestamptz(6)
  ativa              Boolean   @default(true)
  inativadaEm        DateTime? @map("inativada_em") @db.Timestamptz(6)
  criadaEm           DateTime  @map("criada_em") @db.Timestamptz(6)
  versao             Int       @default(1)

  @@index([usuarioId])
  @@map("adm_notificacao_desempenho")
}
